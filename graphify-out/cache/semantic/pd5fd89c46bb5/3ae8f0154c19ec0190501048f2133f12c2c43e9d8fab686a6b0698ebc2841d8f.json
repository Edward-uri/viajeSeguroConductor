{"nodes": [{"id": "readme_jala_pasenger_app", "label": "Jala Passenger App README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clean_architecture", "label": "Clean Architecture (Layers)", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 32-55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-layer dependency rule (presentation -> domain <- data) allows swapping backend, mappers, or HTTP client without touching UI or viewmodels. Domain is pure Dart, unaware of Flutter."}, {"id": "readme_vertical_slicing", "label": "Vertical Slicing (Feature-Based Structure)", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 57-71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouping by feature instead of by technical layer makes features autonomous, prevents cross-feature imports, and lets team members work independently."}, {"id": "readme_screaming_architecture", "label": "Screaming Architecture", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 72-87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level directory structure reveals the app's domain (auth, profile, rides, documents, vehicle) rather than framework folders like controllers/services."}, {"id": "readme_mvvm_pattern", "label": "MVVM Pattern", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 89-100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each feature uses View (Widget), ViewModel (ChangeNotifier), Model (domain entities). View subscribes via context.watch; ViewModel auto-disposes via Riverpod, preventing leaks."}, {"id": "readme_riverpod_di", "label": "Riverpod Dependency Injection", "file_type": "concept", "source_file": "README.md", "source_location": "lines 262-281", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrated from legacy provider to Riverpod for better lifecycle management, native auto-dispose providers, and zero widget-tree dependency for DI."}, {"id": "readme_shared_user_entity", "label": "Shared User Entity", "file_type": "concept", "source_file": "README.md", "source_location": "lines 283-288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User is used by auth (creates) and profile (reads/updates). Placing it in shared/ prevents cross-feature imports, preserving vertical slicing autonomy."}, {"id": "readme_mapper_pattern", "label": "Mapper Pattern (Adapter)", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 289-303", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain entities stay pure (no JSON). Serialization lives in dedicated Mapper classes in data/mappers/, so domain never learns about backend format."}, {"id": "readme_dart_define_env", "label": "Compile-Time Environment Variables (--dart-define-from-file)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 305-318", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chose --dart-define-from-file over flutter_dotenv because flutter_dotenv packages .env as an asset inside APK (readable by anyone), while dart-define injects at compile-time with no plain file left."}, {"id": "readme_jwt_secure_storage", "label": "JWT in flutter_secure_storage", "file_type": "concept", "source_file": "README.md", "source_location": "lines 320-324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Keystore-level encryption on Android instead of SharedPreferences for token security. AuthStorage interface allows swapping implementations for testing."}, {"id": "readme_material3_theme", "label": "Material 3 Theme System", "file_type": "concept", "source_file": "README.md", "source_location": "lines 326-337", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated via Material Theme Builder from four seed colors. All code references Theme.of(context).colorScheme.X instead of raw hex, giving free dark mode and future palette updates."}, {"id": "readme_flag_secure", "label": "FLAG_SECURE (Native Android)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 339-356", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native Kotlin FLAG_SECURE chosen over flutter_windowmanager to avoid extra dependency, activate before Dart code runs, and follow official Android docs."}, {"id": "readme_navigation_1_0", "label": "Navigator 1.0 (Named Routes)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 358-372", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C\u00e1tedra required Navigator 1.0, not go_router or Navigator 2.0. Routes defined as constants in app_routes.dart."}, {"id": "readme_typed_exceptions", "label": "Typed Exceptions Pattern", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 374-383", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chose typed exceptions over Result<T,E> pattern because Dart exceptions with on-catch give the same control with less boilerplate and is more idiomatic."}, {"id": "readme_single_http_client", "label": "Single http.Client Instance", "file_type": "concept", "source_file": "README.md", "source_location": "lines 253-259", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One http.Client for the whole app avoids multiple connection pools, ensures consistent timeouts/headers, and is disposed via Provider.onDispose."}, {"id": "readme_security_risk_detection", "label": "Login Security Risk Detection", "file_type": "concept", "source_file": "README.md", "source_location": "lines 442-457", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_remote_wipe", "label": "Remote Wipe via FCM", "file_type": "concept", "source_file": "README.md", "source_location": "lines 462-478", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sensitive_data_processor", "label": "SensitiveDataProcessor Utility", "file_type": "concept", "source_file": "README.md", "source_location": "lines 552-564", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_auth", "label": "Auth Feature", "file_type": "concept", "source_file": "README.md", "source_location": "lines 165-183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_profile", "label": "Profile Feature", "file_type": "concept", "source_file": "README.md", "source_location": "lines 185-197", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_rides", "label": "Rides Feature", "file_type": "concept", "source_file": "README.md", "source_location": "lines 199-214", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_documents", "label": "Documents Feature", "file_type": "concept", "source_file": "README.md", "source_location": "lines 216-229", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_vehicle", "label": "Vehicle Feature", "file_type": "concept", "source_file": "README.md", "source_location": "lines 231-244", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_auth_flow", "label": "Authentication Flow", "f