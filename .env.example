# === Firebase ===
FIREBASE_API_KEY_WEB=your_firebase_web_api_key
FIREBASE_API_KEY_ANDROID=your_firebase_android_api_key
FIREBASE_API_KEY_IOS=your_firebase_ios_api_key

FIREBASE_APP_ID_WEB=1:project:web:xxxx
FIREBASE_APP_ID_ANDROID=1:project:android:xxxx
FIREBASE_APP_ID_IOS=1:project:ios:xxxx
FIREBASE_APP_ID_MACOS=1:project:ios:xxxx
FIREBASE_APP_ID_WINDOWS=1:project:web:xxxx

FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MEASUREMENT_ID_WEB=G-XXXXX
FIREBASE_MEASUREMENT_ID_WINDOWS=G-XXXXX
FIREBASE_IOS_BUNDLE_ID=com.example.app

# === API ===
API_BASE_URL=https://your-backend.example.com
API_TIMEOUT_SECONDS=15

# === Mapbox ===
# Clave canónica (misma que la app pasajero). MAPBOX_TOKEN sigue aceptada como respaldo.
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token
